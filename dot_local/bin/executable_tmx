#!/usr/bin/env bash
#
# tmx - interactive tmux session picker (attach-or-create) with kill mode
#       and opt-in, name-scoped tmux-resurrect resume.
#
# Behavior:
#   - `-k` / `--kill` as FIRST arg -> fzf multi-select kill picker.
#   - `-r` / `--restore [name]` as FIRST arg -> opt-in resurrect restore.
#       * with a name: restore ONLY that saved session, then attach.
#       * without a name: full tmux-resurrect restore (all saved sessions),
#         then attach the snapshot's active session.
#   - already inside tmux ($TMUX set) -> pass through to real tmux
#   - any other args (e.g. `tmx ls`, `tmx kill-server`) -> pass through to tmux
#   - no args, outside tmux -> fzf picker of live sessions, plus saved
#     (offline) sessions from the last resurrect snapshot shown as
#     "↻ resume: <name>", plus "new session" / "new named session" entries.
#
# Resume model (paired with `@continuum-restore 'off'` in ~/.tmux.conf):
#   Nothing is auto-restored on boot. A saved session is only brought back when
#   you (a) reuse its exact name via "new named session", (b) pick its
#   "↻ resume:" entry, or (c) run `tmx -r <name>`. Per-session restore filters
#   the snapshot into a temp dir and points @resurrect-dir at it for a single
#   restore, so the real save history is never mutated.
#
# Both `tmx` and the interactive `tmux` alias (defined in .zshrc) route here.
# Using `-k` for kill and `-r` for restore deliberately keeps real tmux
# subcommands (kill-server, kill-session, …) passing straight through.

set -o pipefail
if [[ -n "$DEBUG" ]]; then
  set -x
fi

fail() {
  printf '%s\n' "$1" >&2
  exit "${2:-1}"
}

has() {
  command -v "$1" >/dev/null 2>&1
}

has tmux || fail "Can't find tmux in \$PATH"

# --------------------------------------------------------------------------
# tmux-resurrect helpers
# --------------------------------------------------------------------------
resurrect_dir() {
  local d="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"
  [[ -d "$d" ]] || d="$HOME/.tmux/resurrect"
  printf '%s\n' "$d"
}

resurrect_restore_script() {
  printf '%s\n' "$HOME/.tmux/plugins/tmux-resurrect/scripts/restore.sh"
}

# Unique session names present in the last resurrect snapshot.
resurrect_saved_sessions() {
  local last
  last="$(resurrect_dir)/last"
  [[ -r "$last" ]] || return 0
  awk -F '\t' '($1 == "pane" || $1 == "window") { print $2 }' "$last" | sort -u
}

# Succeeds if $1 is a session name present in the snapshot.
resurrect_has_session() {
  local target="$1" s
  while IFS= read -r s; do
    [[ "$s" == "$target" ]] && return 0
  done < <(resurrect_saved_sessions)
  return 1
}

# Restore ONLY the named session from the snapshot. Filters the snapshot into a
# private temp dir and points @resurrect-dir there for one restore, leaving the
# real save history untouched. The session is created detached; the caller is
# responsible for attaching.
resurrect_restore_session() {
  local target="$1" last restore tmpdir
  last="$(resurrect_dir)/last"
  restore="$(resurrect_restore_script)"
  [[ -r "$last" && -x "$restore" ]] || return 1
  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/tmx-resurrect.XXXXXX")" || return 1
  awk -F '\t' -v s="$target" \
    '($1 == "pane" || $1 == "window") && $2 == s' "$last" > "$tmpdir/last"
  if [[ ! -s "$tmpdir/last" ]]; then
    rm -rf "$tmpdir"
    return 1
  fi
  tmux set-option -g @resurrect-dir "$tmpdir"
  "$restore"
  tmux set-option -gu @resurrect-dir
  rm -rf "$tmpdir"
}

# --------------------------------------------------------------------------
# Kill mode: -k / --kill
# --------------------------------------------------------------------------
if [[ "$1" == "-k" || "$1" == "--kill" ]]; then
  shift

  sessions=()
  while IFS= read -r line; do
    sessions+=("$line")
  done < <(tmux list-sessions 2>/dev/null)

  if [[ ${#sessions[@]} -eq 0 ]]; then
    printf '%s\n' "No tmux sessions running."
    exit 0
  fi

  if has fzf; then
    # fzf multi-select; parse session name from "name: ..." lines
    selected="$(printf '%s\n' "${sessions[@]}" | fzf --multi --exit-0 \
      --prompt='Kill session(s) > ' --height=40% --reverse \
      --header='Tab: multi-select · Enter: kill · Esc: cancel')" || exit 0
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      name="${line%%:*}"
      printf '%s\n' "Killing $name"
      tmux kill-session -t "$name"
    done <<< "$selected"
  else
    # Fallback: numbered select, kill one session
    PS3='Kill session (number): '
    select line in "${sessions[@]}"; do
      if [[ -n "$line" ]]; then
        name="${line%%:*}"
        printf '%s\n' "Killing $name"
        tmux kill-session -t "$name"
        break
      fi
    done
  fi
  exit 0
fi

# --------------------------------------------------------------------------
# Opt-in resume mode: -r / --restore [name]
# --------------------------------------------------------------------------
if [[ "$1" == "-r" || "$1" == "--restore" ]]; then
  shift
  restore="$(resurrect_restore_script)"
  [[ -x "$restore" ]] || fail "tmux-resurrect restore script not found."

  if [[ -n "$1" ]]; then
    # Restore only the named session, then attach to it.
    resurrect_has_session "$1" || fail "No saved session named '$1'."
    resurrect_restore_session "$1" || fail "Failed to restore session '$1'."
    [[ -z "$TMUX" ]] && exec tmux attach -t "$1"
    exit 0
  fi

  # Full restore (all saved sessions).
  "$restore"
  if [[ -z "$TMUX" ]]; then
    active="$(awk -F '\t' '$1 == "state" { print $2; exit }' "$(resurrect_dir)/last" 2>/dev/null)"
    [[ -n "$active" ]] && exec tmux attach -t "$active"
    exec tmux attach
  fi
  exit 0
fi

# --------------------------------------------------------------------------
# Pass-through: inside tmux or args supplied
# --------------------------------------------------------------------------
if [[ -n "$TMUX" ]] || (( $# > 0 )); then
  exec tmux "$@"
fi

# --------------------------------------------------------------------------
# Default: attach-or-create picker (+ opt-in resume of saved sessions)
# --------------------------------------------------------------------------
sessions=()
while IFS= read -r name; do
  [[ -n "$name" ]] && sessions+=("$name")
done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)

# Saved-but-not-live sessions available to resume from the last snapshot.
resume_prefix="↻ resume: "
saved=()
while IFS= read -r s; do
  [[ -z "$s" ]] && continue
  tmux has-session -t "=$s" 2>/dev/null && continue
  saved+=("$resume_prefix$s")
done < <(resurrect_saved_sessions)

new_entry="＋ new session"
named_entry="＋ new named session…"
choice=""

if has fzf; then
  choice="$(
    { printf '%s\n' "$new_entry" "$named_entry"
      printf '%s\n' "${sessions[@]}"
      printf '%s\n' "${saved[@]}"; } \
      | awk 'NF' \
      | fzf --prompt='tmux session > ' --height=40% --reverse \
            --header='Enter: attach/create/resume · Esc: cancel'
  )"
else
  # Fallback: plain numbered menu
  PS3='tmux session (number): '
  select choice in "$new_entry" "$named_entry" "${sessions[@]}" "${saved[@]}"; do
    [[ -n "$choice" ]] && break
  done
fi

# Cancelled (Esc / EOF / empty selection): do nothing, stay in shell.
[[ -z "$choice" ]] && exit 0

case "$choice" in
  "$new_entry")
    exec tmux new-session
    ;;
  "$named_entry")
    read -r -p "New session name: " name
    [[ -z "$name" ]] && exit 0
    # Reuse-by-name resume: live -> attach; saved -> restore just that one and
    # attach; otherwise create fresh.
    if tmux has-session -t "=$name" 2>/dev/null; then
      exec tmux attach -t "$name"
    elif resurrect_has_session "$name"; then
      resurrect_restore_session "$name" || exec tmux new-session -A -s "$name"
      exec tmux attach -t "$name"
    else
      exec tmux new-session -A -s "$name"
    fi
    ;;
  "$resume_prefix"*)
    name="${choice#"$resume_prefix"}"
    if tmux has-session -t "=$name" 2>/dev/null; then
      exec tmux attach -t "$name"
    else
      resurrect_restore_session "$name" || fail "Failed to restore session '$name'."
      exec tmux attach -t "$name"
    fi
    ;;
  *)
    exec tmux attach -t "$choice"
    ;;
esac
