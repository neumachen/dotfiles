#!/usr/bin/env python3
"""macos-preferences -- capture, preview, restore and roll back a curated set
of macOS preferences (keyboard shortcuts first) through the `defaults` CLI.

USAGE
  macos-preferences capture  [--profile PATH] [--stdout]
  macos-preferences diff     [--profile PATH] [--only AREA[,AREA...]] [--all]
  macos-preferences restore  [--profile PATH] [--only AREA[,AREA...]] [--yes] [--dry-run]
  macos-preferences rollback [BACKUP|latest] [--yes] [--dry-run]
  macos-preferences validate [--profile PATH]

SUBCOMMANDS
  capture   Read the live preferences named by the built-in allowlist and write
            them to the profile. Never runs implicitly: chezmoi hooks only ever
            call `restore`. Writes the deployed profile
            (~/.config/macos-preferences/profile.json) unless --profile says
            otherwise; publish it with `chezmoi re-add`.
  diff      Compare the profile with this Mac and print what `restore` would
            change. Read-only by construction (the backend is wrapped so any
            write raises). Exit 0 = in sync, 1 = differences, 2 = error.
  restore   Apply the profile with `defaults write` (never `defaults import`,
            never by copying files under Library/Preferences). Backs up every
            affected value first, then reads each write back and compares it
            type-exactly. Exit 0 = done, 1 = a write failed, 2 = usage/profile/
            environment error.
  rollback  Put the values recorded in a restore backup back (deleting keys that
            did not exist before). Takes its own backup first.
  validate  Check a profile against the allowlist and schema. Needs no macOS.

PROFILE
  ~/.config/macos-preferences/profile.json (source: private_dot_config/
  macos-preferences/profile.json). Deterministic JSON, no timestamps, hosts or
  paths. plist types survive: true/false are booleans, 1 is an integer, 1.0 is
  a real, {"$data": base64} is data, {"$date": ISO-8601} is a date. Keys the
  Mac does not have are listed under "absent" and are never written or deleted.

ENVIRONMENT
  MACOS_PREFERENCES_PROFILE      default profile path
  MACOS_PREFERENCES_BACKUP_DIR   backup root (default $XDG_STATE_HOME/macos-preferences/backups)
  MACOS_PREFERENCES_DEFAULTS_BIN `defaults` executable to use (tests point this
                                 at a fake; the default is /usr/bin/defaults)

Full guide: docs/macos-preferences.md in the dotfiles repository.

Logging follows the ~/.local/bin echo-* format ("[LEVEL] --- message") but is
emitted in-process to stderr so stdout stays clean for reports and --stdout.
"""

from __future__ import annotations

import argparse
import base64
import datetime
import hashlib
import json
import math
import os
import plistlib
import re
import struct
import subprocess
import sys
import tempfile
from dataclasses import dataclass, field
from typing import Any, Dict, Iterable, List, Optional, Sequence, Tuple

if sys.version_info < (3, 9):  # pragma: no cover
    sys.exit('macos-preferences: Python 3.9 or newer is required')

TOOL = 'macos-preferences'
SCHEMA = 1
USER = 'user'
HOST = 'currentHost'
SCOPES = (USER, HOST)
GLOBAL = 'NSGlobalDomain'
KEY_EQUIVALENTS = 'NSUserKeyEquivalents'

ENV_PROFILE = 'MACOS_PREFERENCES_PROFILE'
ENV_BACKUP_DIR = 'MACOS_PREFERENCES_BACKUP_DIR'
ENV_DEFAULTS_BIN = 'MACOS_PREFERENCES_DEFAULTS_BIN'

TAG_DATA = '$data'
TAG_DATE = '$date'
TAGS = (TAG_DATA, TAG_DATE)
DATE_FMT = '%Y-%m-%dT%H:%M:%SZ'

DOMAIN_RE = re.compile(r'^[A-Za-z0-9_][A-Za-z0-9_.+-]*$')
COMMAND_TIMEOUT = 60

PROFILE_DESCRIPTION = (
    'Curated macOS preferences captured by macos-preferences. Generated: do '
    'not edit by hand; run `macos-preferences capture`. Absent keys are '
    'listed under "absent" and are never written or deleted on restore.'
)


# ---------------------------------------------------------------------------
# Errors and logging
# ---------------------------------------------------------------------------


class ToolError(Exception):
    """Environment or usage problem; the CLI exits 2."""


class ProfileError(ToolError):
    """Profile/backup failed validation. Carries every message found."""

    def __init__(self, messages: Sequence[str]):
        self.messages = list(messages)
        super().__init__('; '.join(self.messages))


class BackendError(Exception):
    """A `defaults` invocation failed or returned unusable data."""


class Log:
    LEVELS = {'DEBUG': 39, 'SUCCESS': 76, 'WARN': 214, 'ERROR': 167, 'INFO': 34}

    def __init__(self, stream=None):
        self.stream = stream if stream is not None else sys.stderr
        try:
            self.color = self.stream.isatty() and 'NO_COLOR' not in os.environ
        except (AttributeError, ValueError):
            self.color = False

    def _emit(self, level: str, message: str) -> None:
        tag = '[%s] ---' % level
        if self.color:
            tag = '\033[38;5;%dm%s\033[0m' % (self.LEVELS[level], tag)
        self.stream.write('%s %s\n' % (tag, message))
        self.stream.flush()

    def info(self, message: str) -> None:
        self._emit('INFO', message)

    def ok(self, message: str) -> None:
        self._emit('SUCCESS', message)

    def warn(self, message: str) -> None:
        self._emit('WARN', message)

    def err(self, message: str) -> None:
        self._emit('ERROR', message)


class Missing(object):
    """Sentinel for a preference that does not exist (distinct from False/0/'')."""

    def __repr__(self) -> str:
        return '<absent>'


MISSING = Missing()


# ---------------------------------------------------------------------------
# Value model: strict equality and the JSON codec for plist values
# ---------------------------------------------------------------------------


def _norm_dt(value: datetime.datetime) -> datetime.datetime:
    if value.tzinfo is not None:
        value = value.astimezone(datetime.timezone.utc).replace(tzinfo=None)
    return value


def strict_eq(a: Any, b: Any) -> bool:
    """Equality that also compares plist types: True != 1 != 1.0, '1' != 1."""
    if type(a) is not type(b):
        return False
    if isinstance(a, dict):
        return a.keys() == b.keys() and all(strict_eq(a[k], b[k]) for k in a)
    if isinstance(a, list):
        return len(a) == len(b) and all(strict_eq(x, y) for x, y in zip(a, b))
    if isinstance(a, datetime.datetime):
        return _norm_dt(a) == _norm_dt(b)
    return a == b


def key_order(name: str) -> Tuple[int, int, str]:
    """All-digit names (shortcut IDs) sort numerically first, then the rest."""
    if name.isdigit():
        return (0, int(name), name)
    return (1, 0, name)


def to_jsonable(value: Any, path: str = '$') -> Any:
    if isinstance(value, bool):
        return value
    if isinstance(value, int):
        if not -(2 ** 63) <= value <= 2 ** 64 - 1:
            raise ProfileError(['%s: integer outside the plist range' % path])
        return value
    if isinstance(value, float):
        if not math.isfinite(value):
            raise ProfileError(['%s: non-finite real is not representable' % path])
        return value
    if isinstance(value, str):
        return value
    if isinstance(value, (bytes, bytearray)):
        return {TAG_DATA: base64.b64encode(bytes(value)).decode('ascii')}
    if isinstance(value, datetime.datetime):
        value = _norm_dt(value)
        if value.microsecond:
            raise ProfileError(['%s: date with sub-second precision' % path])
        return {TAG_DATE: value.strftime(DATE_FMT)}
    if isinstance(value, list):
        return [to_jsonable(v, '%s[%d]' % (path, i)) for i, v in enumerate(value)]
    if isinstance(value, dict):
        if len(value) == 1 and next(iter(value)) in TAGS:
            raise ProfileError(['%s: a dictionary whose only key is %r collides with the type tags' % (path, next(iter(value)))])
        out = {}
        for k, v in value.items():
            if not isinstance(k, str):
                raise ProfileError(['%s: non-string dictionary key %r' % (path, k)])
            out[k] = to_jsonable(v, '%s.%s' % (path, k))
        return out
    raise ProfileError(['%s: unsupported plist type %s' % (path, type(value).__name__)])


def from_jsonable(value: Any, path: str, errors: List[str]) -> Any:
    if isinstance(value, bool):
        return value
    if isinstance(value, int):
        if not -(2 ** 63) <= value <= 2 ** 64 - 1:
            errors.append('%s: integer outside the plist range' % path)
        return value
    if isinstance(value, float):
        if not math.isfinite(value):
            errors.append('%s: non-finite real' % path)
        return value
    if isinstance(value, str):
        return value
    if isinstance(value, list):
        return [from_jsonable(v, '%s[%d]' % (path, i), errors) for i, v in enumerate(value)]
    if isinstance(value, dict):
        if len(value) == 1:
            (tag, inner), = value.items()
            if tag == TAG_DATA:
                try:
                    if not isinstance(inner, str):
                        raise ValueError('not a string')
                    return base64.b64decode(inner, validate=True)
                except ValueError as exc:
                    errors.append('%s: bad %s payload (%s)' % (path, TAG_DATA, exc))
                    return b''
            if tag == TAG_DATE:
                try:
                    if not isinstance(inner, str):
                        raise ValueError('not a string')
                    return datetime.datetime.strptime(inner, DATE_FMT)
                except ValueError as exc:
                    errors.append('%s: bad %s payload (%s)' % (path, TAG_DATE, exc))
                    return datetime.datetime(1970, 1, 1)
        return {k: from_jsonable(v, '%s.%s' % (path, k), errors) for k, v in value.items()}
    errors.append('%s: unsupported JSON value %r (null is not a plist type)' % (path, value))
    return None


def plist_fragment(value: Any) -> str:
    """XML text of one compound value without the <plist> document wrapper."""
    doc = plistlib.dumps(value, fmt=plistlib.FMT_XML, sort_keys=True).decode('utf-8')
    match = re.search(r'<plist version="1\.0">\n(.*)\n</plist>\s*$', doc, re.S)
    if not match:  # pragma: no cover - plistlib always emits this shape
        raise ToolError('cannot serialise value as a plist fragment')
    return match.group(1)


def scalar_flags(value: Any) -> Optional[List[str]]:
    """`defaults` typed-value flags for a scalar; None means "use a fragment"."""
    if isinstance(value, bool):
        return ['-bool', 'true' if value else 'false']
    if isinstance(value, int):
        return ['-int', str(value)]
    if isinstance(value, float):
        # -float is single precision; anything it cannot hold exactly goes
        # through the XML fragment path instead of being silently rounded.
        if struct.unpack('f', struct.pack('f', value))[0] != value:
            return None
        return ['-float', repr(value)]
    if isinstance(value, str):
        return ['-string', value]
    if isinstance(value, (bytes, bytearray)):
        return ['-data', bytes(value).hex()]
    if isinstance(value, datetime.datetime):
        return ['-date', _norm_dt(value).strftime('%Y-%m-%d %H:%M:%S +0000')]
    return None


def value_args(value: Any) -> List[str]:
    flags = scalar_flags(value)
    if flags is not None:
        return flags
    return [plist_fragment(value)]


# ---------------------------------------------------------------------------
# The allowlist: the only place that decides what can be captured or restored
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class KeySpec:
    area: str
    merge: bool = False  # dictionary restored entry by entry, never replaced
    reject: Tuple[Any, ...] = ()  # values that are machine-specific: never captured


AREAS = {
    'shortcuts': 'Log out and back in; system keyboard shortcuts are read at login.',
    'app-shortcuts': 'Quit and reopen each affected app (menu key equivalents are read at launch).',
    'services': 'Log out and back in; the Services menu and Quick Actions rebuild at login.',
    'keyboard': 'Log out and back in; key repeat and function-key behaviour apply to new sessions.',
    'input-sources': 'Log out and back in; the input-source menu reads its list at login.',
    'trackpad': 'Log out and back in (or toggle the setting once in System Settings > Trackpad).',
    'dock': 'Run `killall Dock`; hot corners, Stage Manager and window tiling may need a logout.',
    'finder': 'Run `killall Finder` to relaunch it with the new settings.',
    'appearance': 'Log out and back in; running apps pick up appearance changes when relaunched.',
}

KEY_INDEX: Dict[Tuple[str, str, str], KeySpec] = {}
DISCOVERED_SPEC = KeySpec('app-shortcuts', merge=True)


def _grp(area: str, domain: str, scope: str, keys: Iterable[str],
         merge: Iterable[str] = (), reject: Optional[Dict[str, Tuple[Any, ...]]] = None) -> None:
    merge_set = set(merge)
    for key in keys:
        ident = (domain, scope, key)
        if ident in KEY_INDEX:
            raise AssertionError('allowlist lists %r twice' % (ident,))
        KEY_INDEX[ident] = KeySpec(area, key in merge_set, tuple((reject or {}).get(key, ())))


