def spec_for(domain: str, scope: str, key: str) -> Optional[KeySpec]:
    spec = KEY_INDEX.get((domain, scope, key))
    if spec is not None:
        return spec
    if scope == USER and key == KEY_EQUIVALENTS and DOMAIN_RE.match(domain):
        return DISCOVERED_SPEC
    return None


def entry_name_problem(name: str) -> Optional[str]:
    if not name:
        return 'empty entry name'
    if name.startswith('-'):
        return 'entry name starts with "-" and would be read as a defaults option'
    return None


def shape_problems(domain: str, key: str, value: Any) -> List[str]:
    """Structural checks for merge keys of a profile (not of a backup)."""
    if not isinstance(value, dict):
        return ['must be a dictionary']
    problems = []
    for name, entry in value.items():
        bad = entry_name_problem(name)
        if bad:
            problems.append('%s: %s' % (name, bad))
        if key == 'AppleSymbolicHotKeys':
            if not name.isdigit():
                problems.append('%s: shortcut IDs are decimal numbers' % name)
            if not isinstance(entry, dict):
                problems.append('%s: shortcut record must be a dictionary' % name)
                continue
            if 'enabled' in entry and not isinstance(entry['enabled'], bool):
                problems.append('%s: "enabled" must be a boolean' % name)
            if 'value' in entry and not isinstance(entry['value'], dict):
                problems.append('%s: "value" must be a dictionary' % name)
        elif key == 'NSServicesStatus':
            if not isinstance(entry, dict):
                problems.append('%s: service record must be a dictionary' % name)
        elif key == KEY_EQUIVALENTS:
            if not isinstance(entry, str):
                problems.append('%s: key equivalent must be a string' % name)
    return problems


# ---------------------------------------------------------------------------
# Profile and backup documents: canonical JSON out, validated data in
# ---------------------------------------------------------------------------

INLINE_WIDTH = 110
INDENT = '  '


def _compact(value: Any) -> str:
    if isinstance(value, dict):
        return '{' + ', '.join(
            '%s: %s' % (json.dumps(k, ensure_ascii=False), _compact(value[k]))
            for k in sorted(value, key=key_order)) + '}'
    if isinstance(value, list):
        return '[' + ', '.join(_compact(v) for v in value) + ']'
    return json.dumps(value, ensure_ascii=False)


def _pretty(value: Any, level: int, lead: int) -> str:
    if isinstance(value, (dict, list)) and value:
        flat = _compact(value)
        if len(INDENT) * level + lead + len(flat) + 1 <= INLINE_WIDTH:
            return flat
        pad = INDENT * (level + 1)
        if isinstance(value, dict):
            rows = []
            for k in sorted(value, key=key_order):
                head = json.dumps(k, ensure_ascii=False) + ': '
                rows.append(pad + head + _pretty(value[k], level + 1, len(head)))
            return '{\n' + ',\n'.join(rows) + '\n' + INDENT * level + '}'
        rows = [pad + _pretty(v, level + 1, 0) for v in value]
        return '[\n' + ',\n'.join(rows) + '\n' + INDENT * level + ']'
    return _compact(value)


def _dump_group(group: Dict[str, Any]) -> str:
    """One preferences[] entry: always expanded, one line per key or record."""
    where = '%s/%s' % (group['domain'], group['scope'])
    keys = {k: to_jsonable(v, '%s/%s' % (where, k)) for k, v in group['keys'].items()}
    pad, deep = INDENT * 3, INDENT * 4
    if keys:
        rows = []
        for k in sorted(keys, key=key_order):
            head = json.dumps(k, ensure_ascii=False) + ': '
            rows.append(deep + head + _pretty(keys[k], 4, len(head)))
        keys_text = '{\n' + ',\n'.join(rows) + '\n' + pad + '}'
    else:
        keys_text = '{}'
    fields = [
        '"domain": %s' % json.dumps(group['domain']),
        '"scope": %s' % json.dumps(group['scope']),
        '"keys": %s' % keys_text,
        '"absent": %s' % _compact(sorted(group['absent'])),
    ]
    return INDENT * 2 + '{\n' + ',\n'.join(pad + f for f in fields) + '\n' + INDENT * 2 + '}'


def dump_document(doc: Dict[str, Any]) -> str:
    """Canonical text of a profile/backup dict holding plist values."""
    rows = []
    for k in ('schema', 'kind', 'created', 'source_profile_sha256', 'description'):
        if k in doc:
            rows.append('%s%s: %s' % (INDENT, json.dumps(k), json.dumps(doc[k], ensure_ascii=False)))
    groups = sorted(doc['preferences'], key=lambda g: (g['domain'], g['scope']))
    body = '[\n' + ',\n'.join(_dump_group(g) for g in groups) + '\n' + INDENT + ']' if groups else '[]'
    rows.append('%s"preferences": %s' % (INDENT, body))
    return '{\n' + ',\n'.join(rows) + '\n}\n'


def documents_equal(a: Dict[str, Any], b: Dict[str, Any]) -> bool:
    """Type-exact comparison of two parsed documents' preference groups."""
    if len(a['preferences']) != len(b['preferences']):
        return False
    return all(x['domain'] == y['domain'] and x['scope'] == y['scope'] and sorted(x['absent']) == sorted(y['absent'])
               and strict_eq(x['keys'], y['keys'])
               for x, y in zip(a['preferences'], b['preferences']))


def _reject_duplicates(pairs: List[Tuple[str, Any]]) -> Dict[str, Any]:
    out: Dict[str, Any] = {}
    for k, v in pairs:
        if k in out:
            raise ValueError('duplicate JSON key %r' % k)
        out[k] = v
    return out


def _reject_constant(name: str) -> Any:
    raise ValueError('%s is not valid JSON' % name)


def parse_document(text: str, kind: str, origin: str) -> Dict[str, Any]:
    """Parse and validate a profile (kind='profile') or backup (kind='backup').

    Raises ProfileError listing every problem, each prefixed with its location.
    """
    try:
        raw = json.loads(text, object_pairs_hook=_reject_duplicates, parse_constant=_reject_constant)
    except ValueError as exc:
        raise ProfileError(['%s: not valid JSON: %s' % (origin, exc)]) from exc
    errors: List[str] = []
    if not isinstance(raw, dict):
        raise ProfileError(['%s: top level must be an object' % origin])

    allowed = {'schema', 'preferences'}
    allowed |= {'description'} if kind == 'profile' else {'kind', 'created', 'source_profile_sha256'}
    for k in raw:
        if k not in allowed:
            errors.append('%s: unknown top-level field %r' % (origin, k))
    if raw.get('schema') != SCHEMA or isinstance(raw.get('schema'), bool):
        errors.append('%s: "schema" must be %d (this tool cannot read schema %r)' % (origin, SCHEMA, raw.get('schema')))
    if kind == 'backup' and raw.get('kind') != 'backup':
        errors.append('%s: not a restore backup (missing "kind": "backup")' % origin)
    prefs = raw.get('preferences')
    if not isinstance(prefs, list):
        errors.append('%s: "preferences" must be a list' % origin)
        raise ProfileError(errors)

    groups = []
    seen = set()
    for i, group in enumerate(prefs):
        where = '%s: preferences[%d]' % (origin, i)
        if not isinstance(group, dict) or set(group) != {'domain', 'scope', 'keys', 'absent'}:
            errors.append('%s: must be an object with exactly domain, scope, keys, absent' % where)
            continue
        domain, scope = group['domain'], group['scope']
        if not isinstance(domain, str) or not DOMAIN_RE.match(domain):
            errors.append('%s: invalid domain %r' % (where, domain))
            continue
        if scope not in SCOPES:
            errors.append('%s (%s): scope must be one of %s' % (where, domain, ', '.join(SCOPES)))
            continue
        where = '%s: %s [%s]' % (origin, domain, scope)
        if (domain, scope) in seen:
            errors.append('%s: listed more than once' % where)
            continue
        seen.add((domain, scope))
        keys, absent = group['keys'], group['absent']
        if not isinstance(keys, dict):
            errors.append('%s: "keys" must be an object' % where)
            continue
        if not isinstance(absent, list) or not all(isinstance(a, str) for a in absent):
            errors.append('%s: "absent" must be a list of key names' % where)
            continue
        if len(set(absent)) != len(absent):
            errors.append('%s: "absent" has duplicates' % where)
        decoded = {}
        for key, value in keys.items():
            if spec_for(domain, scope, key) is None:
                errors.append('%s: key %r is not in the allowlist' % (where, key))
                continue
            decoded[key] = from_jsonable(value, '%s: %s' % (where, key), errors)
            if kind == 'profile' and spec_for(domain, scope, key).merge:
                for problem in shape_problems(domain, key, decoded[key]):
                    errors.append('%s: %s: %s' % (where, key, problem))
        for key in absent:
            if spec_for(domain, scope, key) is None:
                errors.append('%s: absent key %r is not in the allowlist' % (where, key))
            if key in keys:
                errors.append('%s: key %r is both present and absent' % (where, key))
        groups.append({'domain': domain, 'scope': scope, 'keys': decoded, 'absent': sorted(set(absent))})
    if errors:
        raise ProfileError(errors)
    doc = {k: v for k, v in raw.items() if k != 'preferences'}
    doc['preferences'] = groups
    return doc


def load_document(path: str, kind: str) -> Dict[str, Any]:
    try:
        with open(path, 'rb') as handle:
            data = handle.read()
    except OSError as exc:
        raise ToolError('cannot read %s: %s' % (path, exc.strerror or exc)) from exc
    try:
        text = data.decode('utf-8')
    except UnicodeDecodeError as exc:
        raise ProfileError(['%s: not UTF-8 (%s)' % (path, exc)]) from exc
    return parse_document(text, kind, path)


def atomic_write(path: str, text: str, mode: int = 0o644) -> bool:
    """Write `text` to `path` via a temp file; returns False if unchanged."""
    data = text.encode('utf-8')
    try:
        with open(path, 'rb') as handle:
            if handle.read() == data:
                return False
    except OSError:
        pass
    directory = os.path.dirname(os.path.abspath(path))
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix='.macos-preferences.', dir=directory)
    try:
        with os.fdopen(fd, 'wb') as handle:
            handle.write(data)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return True


# ---------------------------------------------------------------------------
# Preference backends
# ---------------------------------------------------------------------------


class DefaultsBackend(object):
    """Reads and writes preferences by shelling out to `defaults`.

    Only argv lists are used (no shell). Every domain and key that reaches here
    has already passed the allowlist, so `defaults` never sees a file path or an
    option-looking domain. The write operations are the ones listed in
    ReadOnlyBackend below; nothing else in this file mutates preferences.
    """

    def __init__(self, binary: str = '/usr/bin/defaults'):
        self.binary = binary

    def _run(self, scope: str, *args: str) -> str:
        argv = [self.binary] + (['-currentHost'] if scope == HOST else []) + list(args)
        try:
            proc = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=COMMAND_TIMEOUT)
        except (OSError, subprocess.SubprocessError) as exc:
            raise BackendError('cannot run %s: %s' % (self.binary, exc)) from exc
        if proc.returncode != 0:
            detail = proc.stderr.decode('utf-8', 'replace').strip() or 'exit status %d' % proc.returncode
            raise BackendError('`%s %s` failed: %s' % (os.path.basename(self.binary), ' '.join(args[:3]), detail))
        return proc.stdout.decode('utf-8', 'replace')

    def export(self, domain: str, scope: str) -> Dict[str, Any]:
        out = self._run(scope, 'export', domain, '-')
        try:
            data = plistlib.loads(out.encode('utf-8'))
        except Exception as exc:
            raise BackendError('unreadable export of %s [%s]: %s' % (domain, scope, exc)) from exc
        if not isinstance(data, dict):
            raise BackendError('export of %s [%s] is not a dictionary' % (domain, scope))
        return data

    def domains(self) -> List[str]:
        out = self._run(USER, 'domains').strip()
        return [d.strip() for d in out.split(',') if d.strip()] if out else []

    def set_key(self, domain: str, scope: str, key: str, value: Any) -> None:
        self._run(scope, 'write', domain, key, *value_args(value))

    def set_entry(self, domain: str, scope: str, key: str, entry: str, value: Any) -> None:
        self._run(scope, 'write', domain, key, '-dict-add', entry, *value_args(value))

    def delete_key(self, domain: str, scope: str, key: str) -> None:
        self._run(scope, 'delete', domain, key)


class ReadOnlyBackend(object):
    """Wraps a backend so preview paths cannot write, however they are called."""

    def __init__(self, inner):
        self._inner = inner

    def export(self, domain: str, scope: str) -> Dict[str, Any]:
        return self._inner.export(domain, scope)

    def domains(self) -> List[str]:
        return self._inner.domains()

    def _refuse(self, *_args, **_kwargs):
        raise AssertionError('write attempted through a read-only backend')

    set_key = set_entry = delete_key = _refuse


# ---------------------------------------------------------------------------
# Capture
# ---------------------------------------------------------------------------


def capture_profile(backend, log: Log) -> Dict[str, Any]:
    groups: Dict[Tuple[str, str], Dict[str, Any]] = {}
    cache: Dict[Tuple[str, str], Dict[str, Any]] = {}

    def exported(domain: str, scope: str) -> Dict[str, Any]:
        if (domain, scope) not in cache:
            cache[(domain, scope)] = backend.export(domain, scope)
        return cache[(domain, scope)]

    def slot(domain: str, scope: str) -> Dict[str, Any]:
        return groups.setdefault((domain, scope), {'domain': domain, 'scope': scope, 'keys': {}, 'absent': []})

    def clean(domain: str, key: str, value: Any) -> Any:
        """Drop merge entries the tool could not restore safely."""
        if isinstance(value, dict):
            kept = {}
            for name, entry in value.items():
                problem = entry_name_problem(name)
                if problem:
                    log.warn('skipping %s / %s / %r: %s' % (domain, key, name, problem))
                else:
                    kept[name] = entry
            return kept
        return value

    for (domain, scope, key), spec in sorted(KEY_INDEX.items()):
        current = exported(domain, scope)
        target = slot(domain, scope)
        if key not in current:
            target['absent'].append(key)
            continue
        value = current[key]
        if any(strict_eq(value, bad) for bad in spec.reject):
            log.warn('skipping %s [%s] %s = %r: machine-specific value (set it by hand on the new Mac)'
                     % (domain, scope, key, value))
            continue
        target['keys'][key] = clean(domain, key, value) if spec.merge else value

    # Per-app menu key-equivalent overrides (System Settings > Keyboard >
    # Keyboard Shortcuts > App Shortcuts) live in each app's own domain, so
    # they are discovered rather than listed.
    unreadable = 0
    for domain in sorted(set(backend.domains())):
        if domain.startswith('.') or domain == GLOBAL:
            continue
        if not DOMAIN_RE.match(domain):
            log.warn('discovery: skipping domain with unsupported name %r' % domain)
            continue
        try:
            current = exported(domain, USER)
        except BackendError:
            unreadable += 1
            continue
        if KEY_EQUIVALENTS not in current:
            continue
        value = current[KEY_EQUIVALENTS]
        if not isinstance(value, dict) or not all(isinstance(v, str) for v in value.values()):
            log.warn('discovery: %s has a %s value that is not a string dictionary; skipped' % (domain, KEY_EQUIVALENTS))
            continue
        slot(domain, USER)['keys'][KEY_EQUIVALENTS] = clean(domain, KEY_EQUIVALENTS, value)
    if unreadable:
        log.warn('discovery: %d domain(s) could not be read and were skipped' % unreadable)

    ordered = [groups[k] for k in sorted(groups)]
    for group in ordered:
        group['absent'] = sorted(group['absent'])
    return {'schema': SCHEMA, 'description': PROFILE_DESCRIPTION, 'preferences': ordered}


def summarize_capture(doc: Dict[str, Any]) -> List[str]:
    lines = []
    present = sum(len(g['keys']) for g in doc['preferences'])
    absent = sum(len(g['absent']) for g in doc['preferences'])
    lines.append('%d domain/scope group(s); %d allowlisted key(s) present, %d absent (recorded as absent, not invented)'
                 % (len(doc['preferences']), present, absent))
    for g in doc['preferences']:
        for key, value in g['keys'].items():
            if key == 'AppleSymbolicHotKeys' and isinstance(value, dict):
                enabled = sum(1 for r in value.values() if isinstance(r, dict) and r.get('enabled') is True)
                disabled = sum(1 for r in value.values() if isinstance(r, dict) and r.get('enabled') is False)
                other = len(value) - enabled - disabled
                lines.append('AppleSymbolicHotKeys: %d records (%d enabled, %d disabled%s)'
                             % (len(value), enabled, disabled, ', %d without a boolean flag' % other if other else ''))
            elif key == 'NSServicesStatus' and isinstance(value, dict):
                lines.append('NSServicesStatus: %d service entries' % len(value))
            elif key == KEY_EQUIVALENTS and isinstance(value, dict):
                lines.append('%s in %s: %d override(s)' % (KEY_EQUIVALENTS, g['domain'], len(value)))
    if not any(KEY_EQUIVALENTS in g['keys'] for g in doc['preferences']):
        lines.append('%s: no overrides found in any readable domain' % KEY_EQUIVALENTS)
    return lines


# ---------------------------------------------------------------------------
# Planning: compare a document with the Mac
# ---------------------------------------------------------------------------


@dataclass
class Change:
    domain: str
    scope: str
    key: str
    entry: Optional[str]  # None for a whole-key change
    action: str  # set-key | set-entry | delete-key
    kind: str  # add | change | remove (display)
    old: Any
    new: Any


@dataclass
class Plan:
    changes: List[Change] = field(default_factory=list)
    same: int = 0
    kept: int = 0  # destination-only entries inside merge keys (left alone)
    left_alone: List[Tuple[str, str, str]] = field(default_factory=list)
    current: Dict[Tuple[str, str], Dict[str, Any]] = field(default_factory=dict)
    samples: List[Tuple[str, str, str, Optional[str]]] = field(default_factory=list)


def build_plan(doc: Dict[str, Any], backend, exact: bool = False,
               only: Optional[Iterable[str]] = None) -> Plan:
    """Compare `doc` with the Mac.

    exact=False (restore): merge keys change entry by entry and nothing is ever
    deleted. exact=True (rollback): keys are set wholesale and keys recorded as
    absent are deleted.
    """
    wanted_areas = set(only) if only else None
    plan = Plan()
    for group in doc['preferences']:
        domain, scope = group['domain'], group['scope']
        current = backend.export(domain, scope)
        plan.current[(domain, scope)] = current
        for key in sorted(group['keys'], key=key_order):
            spec = spec_for(domain, scope, key)
            if spec is None or (wanted_areas is not None and spec.area not in wanted_areas):
                continue
            want = group['keys'][key]
            have = current.get(key, MISSING)
            if spec.merge and not exact and isinstance(want, dict) and (have is MISSING or isinstance(have, dict)):
                have_map = {} if have is MISSING else have
                for entry in sorted(want, key=key_order):
                    old = have_map.get(entry, MISSING)
                    if old is not MISSING and strict_eq(old, want[entry]):
                        plan.same += 1
                        plan.samples.append((domain, scope, key, entry))
                    else:
                        plan.changes.append(Change(domain, scope, key, entry, 'set-entry',
                                                   'add' if old is MISSING else 'change', old, want[entry]))
                plan.kept += sum(1 for e in have_map if e not in want)
                continue
            if have is not MISSING and strict_eq(have, want):
                plan.same += 1
                plan.samples.append((domain, scope, key, None))
            else:
                plan.changes.append(Change(domain, scope, key, None, 'set-key',
                                           'add' if have is MISSING else 'change', have, want))
        for key in group['absent']:
            spec = spec_for(domain, scope, key)
            if spec is None or (wanted_areas is not None and spec.area not in wanted_areas):
                continue
            if key in current:
                if exact:
                    plan.changes.append(Change(domain, scope, key, None, 'delete-key', 'remove', current[key], MISSING))
                else:
                    plan.left_alone.append((domain, scope, key))
    return plan


def _show(value: Any, limit: int = 100) -> str:
    if value is MISSING:
        return '<absent>'
    try:
        text = _compact(to_jsonable(value))
    except ProfileError:
        text = repr(value)
    return text if len(text) <= limit else text[:limit - 1] + '…'


def format_plan(plan: Plan, show_same: bool = False) -> str:
    lines: List[str] = []
    symbol = {'add': '+', 'change': '~', 'remove': '-'}
    last = None
    for ch in plan.changes:
        head = (ch.domain, ch.scope, ch.key)
        if head != last:
            lines.append('%s [%s] %s' % (ch.domain, ch.scope, ch.key))
            last = head
        label = ch.entry if ch.entry is not None else '(whole key)'
        if ch.kind == 'add':
            lines.append('  + %s: %s' % (label, _show(ch.new)))
        elif ch.kind == 'remove':
            lines.append('  - %s: %s' % (label, _show(ch.old)))
        else:
            lines.append('  %s %s: %s -> %s' % (symbol[ch.kind], label, _show(ch.old), _show(ch.new)))
    if show_same:
        for domain, scope, key, entry in plan.samples:
            lines.append('  = %s [%s] %s%s' % (domain, scope, key, '' if entry is None else ' / ' + entry))
    for domain, scope, key in plan.left_alone:
        lines.append('  ! %s [%s] %s: unset in the profile but set here; left unchanged' % (domain, scope, key))
    adds = sum(1 for c in plan.changes if c.kind == 'add')
    changes = sum(1 for c in plan.changes if c.kind == 'change')
    removes = sum(1 for c in plan.changes if c.kind == 'remove')
    summary = '%d to add, %d to change' % (adds, changes)
    if removes:
        summary += ', %d to remove' % removes
    summary += ', %d identical' % plan.same
    if plan.kept:
        summary += ', %d destination-only entries kept' % plan.kept
    if plan.left_alone:
        summary += ', %d unset-in-profile key(s) left unchanged' % len(plan.left_alone)
    lines.append('summary: ' + summary)
    return '\n'.join(lines) + '\n'


# ---------------------------------------------------------------------------
# Backup, apply, rollback
# ---------------------------------------------------------------------------


def backup_root() -> str:
    override = os.environ.get(ENV_BACKUP_DIR)
    if override:
        return override
    state = os.environ.get('XDG_STATE_HOME') or os.path.join(os.path.expanduser('~'), '.local', 'state')
    return os.path.join(state, TOOL, 'backups')


def create_backup(plan: Plan, source_sha256: str) -> str:
    """Record the current value (or absence) of every key `plan` will touch."""
    touched: Dict[Tuple[str, str], Dict[str, Any]] = {}
    seen = set()
    for ch in plan.changes:
        ident = (ch.domain, ch.scope, ch.key)
        if ident in seen:
            continue
        seen.add(ident)
        group = touched.setdefault((ch.domain, ch.scope),
                                   {'domain': ch.domain, 'scope': ch.scope, 'keys': {}, 'absent': []})
        current = plan.current[(ch.domain, ch.scope)]
        if ch.key in current:
            group['keys'][ch.key] = current[ch.key]
        else:
            group['absent'].append(ch.key)
    stamp = datetime.datetime.now(datetime.timezone.utc)
    doc = {
        'schema': SCHEMA,
        'kind': 'backup',
        'created': stamp.strftime(DATE_FMT),
        'source_profile_sha256': source_sha256,
        'preferences': [touched[k] for k in sorted(touched)],
    }
    root = backup_root()
    os.makedirs(root, mode=0o700, exist_ok=True)
    name = stamp.strftime('%Y%m%dT%H%M%SZ')
    for attempt in range(1000):
        path = os.path.join(root, name if attempt == 0 else '%s-%d' % (name, attempt))
        try:
            os.mkdir(path, 0o700)
            break
        except FileExistsError:
            continue
    else:  # pragma: no cover
        raise ToolError('cannot allocate a backup directory under %s' % root)
    atomic_write(os.path.join(path, 'before.json'), dump_document(doc), 0o600)
    return path


def resolve_backup(spec: str) -> str:
    """Accept a backup directory, its before.json, or the word `latest`."""
    if spec == 'latest':
        root = backup_root()
        try:
            names = sorted(n for n in os.listdir(root) if os.path.isfile(os.path.join(root, n, 'before.json')))
        except OSError:
            names = []
        if not names:
            raise ToolError('no backups found under %s' % root)
        return os.path.join(root, names[-1], 'before.json')
    path = os.path.join(spec, 'before.json') if os.path.isdir(spec) else spec
    if not os.path.isfile(path):
        raise ToolError('no backup found at %s' % spec)
    return path


def _dest_matches(change: Change, current: Dict[str, Any]) -> bool:
    if change.action == 'delete-key':
        return change.key not in current
    have = current.get(change.key, MISSING)
    if change.action == 'set-key':
        return have is not MISSING and strict_eq(have, change.new)
    return isinstance(have, dict) and change.entry in have and strict_eq(have[change.entry], change.new)


@dataclass
class ApplyResult:
    applied: int = 0
    failures: List[str] = field(default_factory=list)
    aborted: bool = False
    domains: int = 0


def _write(backend, ch: Change) -> None:
    if ch.action == 'set-key':
        backend.set_key(ch.domain, ch.scope, ch.key, ch.new)
    elif ch.action == 'set-entry':
        backend.set_entry(ch.domain, ch.scope, ch.key, ch.entry, ch.new)
    else:
        backend.delete_key(ch.domain, ch.scope, ch.key)


def _revert(backend, plan: Plan, ch: Change, log: Log) -> None:
    before = plan.current[(ch.domain, ch.scope)].get(ch.key, MISSING)
    try:
        if before is MISSING:
            backend.delete_key(ch.domain, ch.scope, ch.key)
        else:
            backend.set_key(ch.domain, ch.scope, ch.key, before)
        log.warn('reverted %s [%s] %s to its previous value' % (ch.domain, ch.scope, ch.key))
    except BackendError as exc:
        log.err('could not revert %s [%s] %s (%s); use `%s rollback` with the backup' % (ch.domain, ch.scope, ch.key, exc, TOOL))


def apply_plan(backend, plan: Plan, log: Log) -> ApplyResult:
    """Write every change, then read each domain back and compare type-exactly.

    A failing `defaults` call is recorded and the run continues with the next
    change. A read-back mismatch means a value did not land as intended, which
    may be systematic, so that key is reverted and the run stops.
    """
    result = ApplyResult()
    by_group: Dict[Tuple[str, str], List[Change]] = {}
    for ch in plan.changes:
        by_group.setdefault((ch.domain, ch.scope), []).append(ch)
    for (domain, scope), changes in by_group.items():
        written: List[Change] = []
        for ch in changes:
            try:
                _write(backend, ch)
                written.append(ch)
            except BackendError as exc:
                where = '%s [%s] %s%s' % (domain, scope, ch.key, '' if ch.entry is None else ' / ' + ch.entry)
                result.failures.append('%s: %s' % (where, exc))
                log.err('%s: %s' % (where, exc))
        if not written:
            continue
        try:
            current = backend.export(domain, scope)
        except BackendError as exc:
            result.failures.append('%s [%s]: cannot verify writes: %s' % (domain, scope, exc))
            log.err('%s [%s]: cannot verify writes: %s' % (domain, scope, exc))
            result.aborted = True
            break
        mismatched = [ch for ch in written if not _dest_matches(ch, current)]
        result.applied += len(written) - len(mismatched)
        result.domains += 1
        if mismatched:
            reverted = set()
            for ch in mismatched:
                where = '%s [%s] %s%s' % (domain, scope, ch.key, '' if ch.entry is None else ' / ' + ch.entry)
                got = current.get(ch.key, MISSING)
                if ch.entry is not None and isinstance(got, dict):
                    got = got.get(ch.entry, MISSING)
                result.failures.append('%s: wrote %s but read back %s' % (where, _show(ch.new), _show(got)))
                log.err('verification failed for %s: wrote %s, read back %s' % (where, _show(ch.new), _show(got)))
                if (ch.domain, ch.scope, ch.key) not in reverted:
                    reverted.add((ch.domain, ch.scope, ch.key))
                    _revert(backend, plan, ch, log)
            result.aborted = True
            break
    return result


# ---------------------------------------------------------------------------
# Command line
# ---------------------------------------------------------------------------


def default_profile_path() -> str:
    override = os.environ.get(ENV_PROFILE)
    if override:
        return override
    config = os.environ.get('XDG_CONFIG_HOME') or os.path.join(os.path.expanduser('~'), '.config')
    return os.path.join(config, TOOL, 'profile.json')


def make_backend() -> DefaultsBackend:
    override = os.environ.get(ENV_DEFAULTS_BIN)
    if override:
        return DefaultsBackend(override)
    if sys.platform != 'darwin':
        raise ToolError('%s reads and writes macOS preferences; this is not macOS (validate works anywhere)' % TOOL)
    return DefaultsBackend()


def parse_only(value: Optional[str]) -> Optional[List[str]]:
    if not value:
        return None
    names = [n.strip() for n in value.split(',') if n.strip()]
    unknown = [n for n in names if n not in AREAS]
    if unknown:
        raise ToolError('unknown area(s) %s; choose from: %s' % (', '.join(unknown), ', '.join(sorted(AREAS))))
    return names


def profile_sha256(path: str) -> str:
    with open(path, 'rb') as handle:
        return hashlib.sha256(handle.read()).hexdigest()


def cmd_capture(args, log: Log, backend) -> int:
    doc = capture_profile(backend, log)
    text = dump_document(doc)
    # Prove the file we are about to write reads back to exactly what was seen.
    check = parse_document(text, 'profile', 'captured profile')
    if not documents_equal(check, doc):
        raise ToolError('internal error: captured profile does not round-trip')
    for line in summarize_capture(doc):
        log.info(line)
    if args.stdout:
        sys.stdout.write(text)
        return 0
    path = args.profile or default_profile_path()
    changed = atomic_write(path, text)
    log.ok('%s %s' % ('wrote' if changed else 'unchanged:', path))
    if changed and os.path.abspath(path) == os.path.abspath(default_profile_path()):
        log.info('this is the deployed profile; publish it to the source tree with: chezmoi re-add %s' % path)
    return 0


def cmd_diff(args, log: Log, backend) -> int:
    path = args.profile or default_profile_path()
    doc = load_document(path, 'profile')
    plan = build_plan(doc, ReadOnlyBackend(backend), only=parse_only(args.only))
    sys.stdout.write(format_plan(plan, show_same=args.all))
    return 1 if plan.changes else 0


def _confirm(args, count: int, what: str) -> bool:
    if args.yes:
        return True
    if not sys.stdin.isatty():
        raise ToolError('refusing to change preferences without a terminal to confirm; pass --yes')
    sys.stderr.write('Apply %d change(s) (%s)? [y/N] ' % (count, what))
    sys.stderr.flush()
    return sys.stdin.readline().strip().lower() in ('y', 'yes')


def _apply(doc: Dict[str, Any], source_sha: str, args, log: Log, backend, exact: bool,
           only: Optional[List[str]], what: str) -> int:
    plan = build_plan(doc, backend if not args.dry_run else ReadOnlyBackend(backend), exact=exact, only=only)
    if not plan.changes:
        log.ok('already in sync; nothing to change')
        return 0
    sys.stdout.write(format_plan(plan))
    if args.dry_run:
        log.info('dry run: nothing was written')
        return 0
    if not _confirm(args, len(plan.changes), what):
        log.info('cancelled')
        return 0
    backup = create_backup(plan, source_sha)
    log.info('backed up the %d affected key(s) to %s' % (len({(c.domain, c.scope, c.key) for c in plan.changes}), backup))
    result = apply_plan(backend, plan, log)
    areas = sorted({spec_for(c.domain, c.scope, c.key).area for c in plan.changes})
    if result.failures:
        log.err('%d problem(s); %d change(s) verified' % (len(result.failures), result.applied))
        if result.aborted:
            log.err('stopped early; remaining changes were not attempted')
        log.info('undo with: %s rollback %s' % (TOOL, backup))
        return 1
    log.ok('applied and verified %d change(s) in %d domain(s)' % (result.applied, result.domains))
    log.info('undo with: %s rollback %s' % (TOOL, backup))
    for area in areas:
        log.info('%s: %s' % (area, AREAS[area]))
    return 0


def cmd_restore(args, log: Log, backend) -> int:
    path = args.profile or default_profile_path()
    doc = load_document(path, 'profile')
    return _apply(doc, profile_sha256(path), args, log, backend, False, parse_only(args.only), 'restore')


def cmd_rollback(args, log: Log, backend) -> int:
    path = resolve_backup(args.backup)
    doc = load_document(path, 'backup')
    log.info('rolling back to %s' % path)
    return _apply(doc, profile_sha256(path), args, log, backend, True, None, 'rollback')


def cmd_validate(args, log: Log, backend) -> int:
    path = args.profile or default_profile_path()
    doc = load_document(path, 'profile')
    keys = sum(len(g['keys']) for g in doc['preferences'])
    log.ok('%s is valid: %d group(s), %d key(s)' % (path, len(doc['preferences']), keys))
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=TOOL, formatter_class=argparse.RawDescriptionHelpFormatter,
        description='Capture, preview, restore and roll back curated macOS preferences.',
        epilog='Areas for --only: %s\nGuide: docs/macos-preferences.md' % ', '.join(sorted(AREAS)))
    sub = parser.add_subparsers(dest='command', metavar='COMMAND')
    sub.required = True

    def add_profile(p):
        p.add_argument('--profile', help='profile path (default: $%s or ~/.config/%s/profile.json)' % (ENV_PROFILE, TOOL))

    p = sub.add_parser('capture', help='read the allowlisted preferences into the profile')
    add_profile(p)
    p.add_argument('--stdout', action='store_true', help='print the profile instead of writing it')
    p.set_defaults(func=cmd_capture, needs_backend=True)

    p = sub.add_parser('diff', aliases=['preview'], help='show what restore would change (read-only)')
    add_profile(p)
    p.add_argument('--only', help='comma-separated areas')
    p.add_argument('--all', action='store_true', help='also list identical entries')
    p.set_defaults(func=cmd_diff, needs_backend=True)

    p = sub.add_parser('restore', help='apply the profile with defaults write (backs up first)')
    add_profile(p)
    p.add_argument('--only', help='comma-separated areas')
    p.add_argument('--yes', '-y', action='store_true', help='do not ask for confirmation')
    p.add_argument('--dry-run', action='store_true', help='show the changes; write nothing')
    p.set_defaults(func=cmd_restore, needs_backend=True)

    p = sub.add_parser('rollback', help='put a restore backup back')
    p.add_argument('backup', nargs='?', default='latest', help='backup directory, its before.json, or "latest"')
    p.add_argument('--yes', '-y', action='store_true', help='do not ask for confirmation')
    p.add_argument('--dry-run', action='store_true', help='show the changes; write nothing')
    p.set_defaults(func=cmd_rollback, needs_backend=True)

    p = sub.add_parser('validate', help='check a profile against the allowlist and schema')
    add_profile(p)
    p.set_defaults(func=cmd_validate, needs_backend=False)
    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    log = Log()
    args = build_parser().parse_args(argv)
    try:
        backend = make_backend() if args.needs_backend else None
        return args.func(args, log, backend)
    except ProfileError as exc:
        for message in exc.messages:
            log.err(message)
        return 2
    except ToolError as exc:
        log.err(str(exc))
        return 2
    except BackendError as exc:
        log.err(str(exc))
        return 2


if __name__ == '__main__':
    sys.exit(main())
