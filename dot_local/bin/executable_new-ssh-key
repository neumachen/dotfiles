#!/bin/sh

DEFAULT_FILENAME=id_ed25519
DEFAULT_EMAIL=kareem@hepburn.info

printf "Email: "
read -r EMAIL

if [ -z "$EMAIL" ]; then
  EMAIL="$DEFAULT_EMAIL"
fi

printf "Filename: "
read -r FILENAME

if [ -z "$FILENAME" ]; then
  FILENAME="$DEFAULT_FILENAME"
fi

# Both prompts are answered before any path is derived. The backup check used to
# sit at the top of this script and read "${HOME}/.ssh/${FILENAME}.pub" before
# FILENAME was assigned, so it always tested "${HOME}/.ssh/.pub" (and was an
# unbound-variable error under `set -u`). Its messages and mv targets also
# hardcoded id_rsa/id_rsa.pub even though this script generates an ed25519 key,
# so it checked one file and backed up two unrelated ones.
KEYFILE="${HOME}/.ssh/${FILENAME}"
PUBKEY="${KEYFILE}.pub"

if [ -r "${PUBKEY}" ]; then
  echo "Backing up old keys to ${KEYFILE}.bak and ${PUBKEY}.bak"
  echo-run mv "${KEYFILE}" "${KEYFILE}.bak"
  echo-run mv "${PUBKEY}" "${PUBKEY}.bak"
fi

echo-run ssh-keygen -C "$EMAIL" -N "" -b 4096 -t ed25519 -f "${KEYFILE}" || exit 1

echo

printf "Enter the server url (user@host): "
read -r SERVER

if [ -z "$SERVER" ]; then
  echo "Server empty, not copying"
  echo "Use ssh-copy-id script to manually copy"
  exit 1
fi

echo-run ssh-copy-id "$SERVER" || exit 1

if [ -x "$(command -v pbcopy)" ]; then
  echo "Copying public key to clipboard."
  echo "Add key to GitHub here: https://github.com/settings/keys"

  pbcopy <"${PUBKEY}"
fi
