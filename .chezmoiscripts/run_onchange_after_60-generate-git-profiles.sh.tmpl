#!/bin/bash
# vim: ft=bash
# Generate git profile files from chezmoi data
#
# D1: .git.profiles is read defensively. A pre-refactor ~/.config/chezmoi/chezmoi.yaml
# may have no `git` block at all, and chezmoi only warns (never regenerates) when
# .chezmoi.yaml.tmpl changes, so an unguarded read here hard-fails the whole apply.
{{- $gitProfiles := list -}}
{{- if and (hasKey . "git") (hasKey .git "profiles") .git.profiles -}}
  {{- $gitProfiles = .git.profiles -}}
{{- end -}}
# Hash: {{ if $gitProfiles }}{{ $gitProfiles | toJson | sha256sum }}{{ else }}empty{{ end }}

set -euo pipefail

PROFILES_DIR="${HOME}/.config/git/profiles"
mkdir -p "${PROFILES_DIR}"

{{ if $gitProfiles -}}
{{ range $gitProfiles }}
cat > "${PROFILES_DIR}/{{ .name }}" << 'PROFILE_EOF'
# vim:ft=gitconfig
# Generated by chezmoi - do not edit directly
[user]
  email = {{ .email }}
{{- if .signingKey }}
  signingKey = {{ .signingKey }}
{{- end }}
{{- if .userName }}
  name = {{ .userName }}
{{- end }}
PROFILE_EOF

echo "Generated git profile: {{ .name }}"
{{ end }}
{{- else }}
echo "No git profiles configured"
{{- end }}
