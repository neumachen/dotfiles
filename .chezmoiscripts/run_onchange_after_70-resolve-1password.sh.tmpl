#!/bin/bash
{{- /* D1: every key read below is new in the C1 schema. chezmoi only regenerates
       ~/.config/chezmoi/chezmoi.yaml on `chezmoi init` (a plain apply just warns
       "config file template has changed"), so a legacy config has none of them and
       an unguarded access aborts the entire apply. Absent keys degrade to the safe
       deferred value: enabled=false, app_path/account/ssh_key_item/vault="",
       secrets={} (empty dict, so the ranges below emit nothing). */ -}}
{{- $opEnabled := false -}}
{{- $opApp := "" -}}
{{- $opAccount := "" -}}
{{- $opItem := "" -}}
{{- $opVault := "" -}}
{{- $secrets := dict -}}
{{- if hasKey . "onepassword" -}}
  {{- if hasKey .onepassword "enabled" -}}{{- $opEnabled = .onepassword.enabled -}}{{- end -}}
  {{- if hasKey .onepassword "app_path" -}}{{- $opApp = .onepassword.app_path -}}{{- end -}}
  {{- if hasKey .onepassword "account" -}}{{- $opAccount = .onepassword.account -}}{{- end -}}
  {{- if hasKey .onepassword "ssh_key_item" -}}{{- $opItem = .onepassword.ssh_key_item -}}{{- end -}}
  {{- if hasKey .onepassword "vault" -}}{{- $opVault = .onepassword.vault -}}{{- end -}}
{{- end -}}
{{- if hasKey . "secrets" -}}{{- $secrets = .secrets -}}{{- end }}
# dep hash: enabled={{ $opEnabled }}
# dep hash: op={{ if lookPath "op" }}yes{{ else }}no{{ end }}
# dep hash: app={{ $opApp }}
# dep hash: vault={{ $opVault }}
# dep hash: item={{ $opItem }}
# dep hash: account={{ $opAccount }}
# dep hash: keyfile={{ if stat (joinPath .chezmoi.homeDir ".config/git/ssh-signing-key") }}yes{{ else }}no{{ end }}
# dep hash: secretsfile={{ if stat (joinPath .chezmoi.homeDir ".config/sh/secrets.env") }}yes{{ else }}no{{ end }}
# dep hash: secrets={{ $secrets | toJson | sha256sum }}
#
# Resolves 1Password items into two pieces of *resolved state* that other
# templates and hooks read (see .chezmoiignore — neither file is chezmoi-managed):
#
#   ~/.config/git/ssh-signing-key   one line: the SSH *public* key
#   ~/.config/sh/secrets.env        export NAME='<value>' lines, mode 0600
#
# Convergence: every prerequisite is in the dep hash above, so chezmoi re-runs
# this hook automatically the moment `op` is installed, the vault is filled in,
# or a resolved file goes missing. Missing prerequisite => warn + exit 0
# (deferred). Prerequisites present but resolution failed => exit non-zero so
# chezmoi does NOT record the hook as done and retries on the next apply.
#
# SECURITY: resolved values are never echoed, logged, or written anywhere except
# the 0600 destination files. Only variable NAMES appear in the log.

set -euo pipefail

# Ensure Homebrew is in PATH
if [ -f /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -f /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

LOCAL_BIN="${HOME}/.local/bin"
if [ -d "${LOCAL_BIN}" ]; then
  export PATH="${LOCAL_BIN}:${PATH}"
fi

_log_info()  { if command -v echo-info  &>/dev/null; then echo-info  "$@"; else echo "[INFO] --- $*"; fi; }
_log_ok()    { if command -v echo-ok    &>/dev/null; then echo-ok    "$@"; else echo "[SUCCESS] --- $*"; fi; }
_log_warn()  { if command -v echo-warn  &>/dev/null; then echo-warn  "$@"; else echo "[WARN] --- $*" >&2; fi; }
_log_err()   { if command -v echo-err   &>/dev/null; then echo-err   "$@"; else echo "[ERROR] --- $*" >&2; fi; }

# D2: `.chezmoi.yaml.tmpl` stores the literal "-" for an optional value the user
# deliberately skipped, so that empty-means-unset does not re-prompt it on every
# future `chezmoi init`. Every consumer folds that sentinel back to empty here.
# bash 3.2 compatible: a case statement, no ${x,,} and no associative arrays.
_norm() { # D2: map the skip sentinel to empty. Trims surrounding whitespace and
  # folds case, so "-", " none ", "None" and "NONE" all normalise while real
  # values such as "NONE-SENSE" are preserved. bash 3.2 has no ${x,,}, hence tr.
  local v="$1"
  v="${v#"${v%%[![:space:]]*}"}"   # trim leading whitespace
  v="${v%"${v##*[![:space:]]}"}"   # trim trailing whitespace
  case "$v" in
    ""|-) printf '' ; return 0 ;;
  esac
  case "$(printf '%s' "$v" | tr '[:upper:]' '[:lower:]')" in
    none) printf '' ;;
    *)    printf '%s' "$v" ;;
  esac
}

# --- template data ---------------------------------------------------------

OP_ENABLED="{{ $opEnabled }}"
OP_APP="$(_norm "{{ $opApp }}")"
OP_VAULT="$(_norm "{{ $opVault }}")"
OP_ITEM="$(_norm "{{ $opItem }}")"
OP_ACCOUNT="$(_norm "{{ $opAccount }}")"

CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}"
KEY_FILE="${CONFIG_DIR}/git/ssh-signing-key"
SECRETS_FILE="${CONFIG_DIR}/sh/secrets.env"

# Secret NAME -> 1Password reference pairs, rendered from .secrets. Values are
# double-quoted with $ ` " and \ escaped so a reference containing shell
# metacharacters (1Password item titles may contain spaces and punctuation)
# survives intact. The `if` guard omits empty references AND the D2 "-" / "none"
# skip sentinels, so the arrays hold only references worth resolving.
SECRET_NAMES=({{- range $name, $ref := $secrets }}{{ if and $ref (ne $ref "-") (ne $ref "none") }}
  "{{ $name }}"
{{- end }}{{ end }}
)
SECRET_REFS=({{- range $name, $ref := $secrets }}{{ if and $ref (ne $ref "-") (ne $ref "none") }}
  "{{ $ref | replace "\\" "\\\\" | replace "\"" "\\\"" | replace "$" "\\$" | replace "`" "\\`" }}"
{{- end }}{{ end }}
)

# --- temp-file bookkeeping (never leave a secret behind on failure) --------

TMP_FILES=()
_cleanup() {
  local f
  for f in ${TMP_FILES[@]+"${TMP_FILES[@]}"}; do
    rm -f "${f}"
  done
}
trap _cleanup EXIT

# make_tmp_in <dir> <prefix> -> sets TMP_PATH to a fresh 0600 temp path inside
# <dir> and registers it for cleanup.
#
# Deliberately NOT `tmp="$(make_tmp_in ...)"`: a command substitution runs in a
# subshell, so the TMP_FILES+=(...) registration would be lost and the EXIT trap
# would leak a 0600 file holding secret material. Same directory as the
# destination so the final mv(1) in publish() is atomic.
TMP_PATH=""
make_tmp_in() {
  local dir="$1" prefix="$2"
  mkdir -p "${dir}"
  TMP_PATH="$(mktemp "${dir}/.${prefix}.XXXXXX")"
  chmod 600 "${TMP_PATH}"
  TMP_FILES+=("${TMP_PATH}")
}

# publish <src> <dest> -> atomically installs <src> as <dest> with mode 0600.
# Returns 0 if <dest> changed, 1 if it already had identical content (so the
# caller can log "unchanged" instead of churning mtime on every apply).
publish() {
  local src="$1" dest="$2"
  mkdir -p "$(dirname "${dest}")"
  chmod 600 "${src}"
  if [ -f "${dest}" ] && cmp -s "${src}" "${dest}"; then
    rm -f "${src}"
    return 1
  fi
  mv -f "${src}" "${dest}"
  return 0
}

# shell_squote <value> -> echoes <value> wrapped in single quotes, with any
# embedded single quote rendered as the four-character sequence '\'' (valid in
# both bash and zsh). Multi-line values are safe: a single-quoted shell string
# may span newlines, and only the quote escaping is line-oriented.
#
# NOTE: this deliberately uses sed rather than ${v//\'/\'\\\'\'}. macOS
# /bin/bash is 3.2, which does not strip backslashes from a ${var//pat/repl}
# replacement the way bash 4+ does — the parameter-expansion form yields
# '\'\\'\' there and silently corrupts the value. Verified against both
# /bin/bash 3.2.57 and bash 5.3.
shell_squote() {
  local escaped
  escaped="$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
  printf "'%s'" "${escaped}"
}

# Optional 1Password account shorthand. Empty means "whatever op defaults to".
# Kept as an array so the ${arr[@]+...} guard stays bash-3.2 / `set -u` safe
# (/bin/bash on macOS is 3.2, where "${arr[@]}" on an empty array is an
# unbound-variable error).
OP_GLOBAL_ARGS=()
if [ -n "${OP_ACCOUNT}" ]; then
  OP_GLOBAL_ARGS=(--account "${OP_ACCOUNT}")
fi

_op() {
  # Thin wrapper so every op(1) call carries the account shorthand.
  op ${OP_GLOBAL_ARGS[@]+"${OP_GLOBAL_ARGS[@]}"} "$@"
}

_op_agent_sock() {
  # 1Password's SSH agent socket. The calling shell normally exports
  # SSH_AUTH_SOCK, but `chezmoi apply` can be run from a context that does not.
  local sock="${SSH_AUTH_SOCK:-}"
  if [ -z "${sock}" ]; then
    sock="${HOME}/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  fi
  printf '%s' "${sock}"
}

_op_item_title() {
  # Item title, used as the ssh-add(1) comment match key. `--fields title`
  # works on current op releases; the sed scrape is the no-jq fallback (jq is
  # not guaranteed to exist this early in the bootstrap).
  local t=""
  t="$(_op item get "${OP_ITEM}" --vault "${OP_VAULT}" --fields title 2>/dev/null | head -n 1 || true)"
  if [ -z "${t}" ]; then
    t="$(_op item get "${OP_ITEM}" --vault "${OP_VAULT}" --format json 2>/dev/null \
      | sed -n 's/.*"title"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1 || true)"
  fi
  printf '%s' "${t}"
}

# resolve_ssh_pubkey -> echoes the SSH *public* key on success, returns 1 if it
# could not be determined. Never prints a private key.
resolve_ssh_pubkey() {
  local out="" title="" line rest comment matched="" matches=0

  # Preferred: read the public_key field straight off the 1Password item.
  if out="$(_op item get "${OP_ITEM}" --vault "${OP_VAULT}" --fields label=public_key 2>/dev/null)" \
    && [ -n "${out}" ]; then
    printf '%s\n' "${out}" | head -n 1
    return 0
  fi

  # Fallback: the 1Password SSH agent may already be serving the key. It uses
  # the item title as the key comment, so match `ssh-add -L` output on that.
  title="$(_op_item_title)"
  if [ -z "${title}" ]; then
    return 1
  fi
  while IFS= read -r line; do
    [ -n "${line}" ] || continue
    rest="${line#* }"      # drop the key type
    comment="${rest#* }"   # drop the base64 blob -> the comment
    if [ "${comment}" = "${title}" ]; then
      matched="${line}"
      matches=$((matches + 1))
    fi
  done <<EOF
$(SSH_AUTH_SOCK="$(_op_agent_sock)" ssh-add -L 2>/dev/null || true)
EOF
  if [ "${matches}" -eq 1 ]; then
    printf '%s\n' "${matched}"
    return 0
  fi
  return 1
}

# --- prerequisite gates: absent/deferred => warn + exit 0 ------------------

if [ "${OP_ENABLED}" != "true" ]; then
  _log_warn "deferred: onepassword.enabled is false; nothing to resolve"
  exit 0
fi

if [ -z "${OP_APP}" ]; then
  _log_warn "deferred: 1Password.app not found (onepassword.app_path is empty)."
  _log_warn "  Install the 1Password cask, then re-run 'chezmoi apply'."
  exit 0
fi

if [ -z "${OP_VAULT}" ]; then
  _log_warn "deferred: onepassword.vault is empty; run 'chezmoi init' to set it."
  exit 0
fi

if [ -z "${OP_ITEM}" ] && [ "${#SECRET_NAMES[@]}" -eq 0 ]; then
  _log_warn "deferred: neither onepassword.ssh_key_item nor any secrets reference is configured."
  exit 0
fi

if ! command -v op &>/dev/null; then
  _log_warn "deferred: 1Password CLI (op) is not on PATH."
  _log_warn "  Install 'cask 1password-cli' (it is in the Brewfile), then re-run 'chezmoi apply'."
  exit 0
fi

if ! _op account list >/dev/null 2>&1; then
  _log_warn "deferred: 'op account list' failed — the 1Password CLI cannot reach the desktop app."
  _log_warn "  Fix: 1Password → Settings → Developer → enable \"Integrate with 1Password CLI\","
  _log_warn "  then re-run 'chezmoi apply'."
  exit 0
fi

if ! _op vault get "${OP_VAULT}" >/dev/null 2>&1; then
  _log_warn "deferred: vault '${OP_VAULT}' is not reachable (1Password locked, or the vault is not in this account)."
  _log_warn "  Unlock 1Password, then re-run 'chezmoi apply'."
  exit 0
fi

# --- from here on, prerequisites are present: failures are genuine ---------

failed=0

# 1. SSH public key -> ~/.config/git/ssh-signing-key
if [ -n "${OP_ITEM}" ]; then
  _log_info "Resolving SSH public key from 1Password item '${OP_ITEM}' (vault '${OP_VAULT}')..."
  make_tmp_in "$(dirname "${KEY_FILE}")" "ssh-signing-key"
  key_tmp="${TMP_PATH}"
  if pubkey="$(resolve_ssh_pubkey)" && [ -n "${pubkey}" ]; then
    printf '%s\n' "${pubkey}" > "${key_tmp}"
    unset pubkey
    if publish "${key_tmp}" "${KEY_FILE}"; then
      _log_ok "Wrote ${KEY_FILE} (mode 0600)."
    else
      _log_info "${KEY_FILE} already up to date."
    fi
  else
    rm -f "${key_tmp}"
    _log_err "Could not resolve an SSH public key from item '${OP_ITEM}' in vault '${OP_VAULT}'."
    _log_err "  Expected a 'public_key' field, or the key served by the 1Password SSH agent"
    _log_err "  with a comment equal to the item title."
    failed=1
  fi
fi

# 2. Secrets -> ~/.config/sh/secrets.env
if [ "${#SECRET_NAMES[@]}" -gt 0 ]; then
  _log_info "Resolving ${#SECRET_NAMES[@]} secret reference(s) from 1Password..."
  make_tmp_in "$(dirname "${SECRETS_FILE}")" "secrets.env"
  secrets_tmp="${TMP_PATH}"
  {
    printf '# Generated by chezmoi run_onchange_after_70-resolve-1password. Do not edit.\n'
    printf '# Values are resolved from 1Password at apply time. Never commit this file.\n'
  } > "${secrets_tmp}"

  i=0
  while [ "${i}" -lt "${#SECRET_NAMES[@]}" ]; do
    name="${SECRET_NAMES[$i]}"
    ref="$(_norm "${SECRET_REFS[$i]}")"
    if [ -z "${ref}" ]; then
      # A "-" / "none" skip sentinel that reached us anyway: skipped, not a
      # failure. The template filter above normally removes these already.
      i=$((i + 1))
      continue
    fi
    # NOTE: `value` holds a secret. It is only ever written to the 0600 temp
    # file below — never echoed, never passed to a _log_* helper.
    if value="$(_op read "${ref}" 2>/dev/null)" && [ -n "${value}" ]; then
      printf 'export %s=%s\n' "${name}" "$(shell_squote "${value}")" >> "${secrets_tmp}"
      _log_ok "Resolved secret: ${name}"
    else
      _log_err "Failed to resolve secret: ${name} (reference is set but 'op read' returned nothing)."
      failed=1
    fi
    unset value
    i=$((i + 1))
  done

  if [ "${failed}" -eq 0 ]; then
    if publish "${secrets_tmp}" "${SECRETS_FILE}"; then
      _log_ok "Wrote ${SECRETS_FILE} (mode 0600)."
    else
      _log_info "${SECRETS_FILE} already up to date."
    fi
  else
    # Do not publish a partial file: a silently missing export is worse than a
    # visible failure. The temp file is removed by the EXIT trap.
    _log_err "Not writing ${SECRETS_FILE}: one or more secrets failed to resolve."
  fi
fi

if [ "${failed}" -ne 0 ]; then
  _log_err "1Password resolution failed. Re-run 'chezmoi apply' once the errors above are fixed."
  exit 1
fi

_log_ok "1Password resolution complete."
