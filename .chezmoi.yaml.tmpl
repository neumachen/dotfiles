# vim: ft=yaml
---
{{- /*
  Resolve the 1Password app bundle path.

  This is stored as data (.onepassword.app_path) instead of being used to gate
  the prompts below. On a fresh Mac, 1Password is a Brewfile cask installed
  *after* `chezmoi init` has already rendered this file, so gating the prompts
  on the bundle made them permanently unreachable.

  Empty-means-unset: promptStringOnce/promptBoolOnce return the stored value
  whenever the key exists -- even when that value is "" -- so one blank answer
  poisons the config forever and is never re-asked. Every value below is
  therefore read behind an explicit hasKey guard and re-prompted with plain
  promptString/promptBool whenever the stored value is empty. Plain prompt*
  still persists, because the rendered output of this template *is* the config
  file and the value is emitted into data:.

  The skip sentinel means "do not configure this". It is matched after trimming
  surrounding whitespace and folding case, so "-", "None", "NONE" and " none "
  all count. It is handled two ways:
    * MANDATORY values (git.email, git.name) store "", so empty-means-unset asks
      again on the next `chezmoi init`.
    * OPTIONAL values (onepassword.account, onepassword.ssh_key_item) -- and onepassword.vault, which has a real default
      of "Private" but may still be answered with the sentinel -- store the
      literal "-" verbatim. Storing "" there made a deliberate skip
      indistinguishable from "never asked", so the value was re-prompted on
      every future `chezmoi init` -- defeating the one-shot goal. Every consumer
      normalises "-" back to empty at read time; see `_norm` in
      run_onchange_after_70-resolve-1password.sh.tmpl,
      run_onchange_after_75-switch-to-ssh.sh.tmpl,
      run_after_99-bootstrap-status.sh.tmpl and
      dot_local/bin/executable_bootstrap-status.
*/ -}}
{{- $onePasswordApp := "" -}}
{{- if stat "/Applications/1Password.app" -}}
  {{- $onePasswordApp = "/Applications/1Password.app" -}}
{{- else if stat (joinPath .chezmoi.homeDir "Applications/1Password.app") -}}
  {{- $onePasswordApp = joinPath .chezmoi.homeDir "Applications/1Password.app" -}}
{{- end -}}
{{- $gitEmail := "" -}}
{{- if and (hasKey . "git") (hasKey .git "email") -}}
  {{- $gitEmail = .git.email -}}
{{- end -}}
{{- if eq $gitEmail "" -}}
  {{- $gitEmail = promptString "Git user email" -}}
{{- end -}}
{{- $gitName := "" -}}
{{- if and (hasKey . "git") (hasKey .git "name") -}}
  {{- $gitName = .git.name -}}
{{- end -}}
{{- if eq $gitName "" -}}
  {{- $gitName = promptString "Git user name" -}}
{{- end -}}
{{- $opEnabled := true -}}
{{- if and (hasKey . "onepassword") (hasKey .onepassword "enabled") -}}
  {{- $opEnabled = .onepassword.enabled -}}
{{- else -}}
  {{- $opEnabled = promptBool "Use 1Password for git SSH signing and secrets" true -}}
{{- end -}}
{{- $vault := "" -}}
{{- $sshKeyItem := "" -}}
{{- $opAccount := "" -}}
{{- if $opEnabled -}}
  {{- if and (hasKey . "onepassword") (hasKey .onepassword "vault") -}}
    {{- $vault = .onepassword.vault -}}
  {{- end -}}
  {{- if eq $vault "" -}}
    {{- $vault = promptString "1Password vault name (e.g. Private)" "Private" -}}
  {{- end -}}
  {{- /* Trimmed and case-insensitive. The vault is mandatory, but a "-" answer
        is still stored verbatim rather than as "": storing "" would make
        empty-means-unset re-ask it on every future `chezmoi init`, which is the
        exact loop D2 exists to break. Consumers normalise "-" to "not
        configured"; `install.sh --reprompt` is how it gets changed later. */ -}}
  {{- $vault = trim $vault -}}
  {{- if or (eq $vault "-") (eq (lower $vault) "none") -}}{{- $vault = "-" -}}{{- end -}}
  {{- if and (hasKey . "onepassword") (hasKey .onepassword "ssh_key_item") -}}
    {{- $sshKeyItem = .onepassword.ssh_key_item -}}
  {{- end -}}
  {{- if eq $sshKeyItem "" -}}
    {{- $sshKeyItem = promptString "1Password item NAME or UUID holding your SSH key (optional; enter - to skip permanently)" -}}
  {{- end -}}
  {{- /* OPTIONAL: keep the sentinel verbatim (trimmed, case-insensitive) so a
        deliberate skip is not re-asked on every future `chezmoi init`.
        Consumers normalise it. */ -}}
  {{- $sshKeyItem = trim $sshKeyItem -}}
  {{- if or (eq $sshKeyItem "-") (eq (lower $sshKeyItem) "none") -}}{{- $sshKeyItem = "-" -}}{{- end -}}
  {{- if and (hasKey . "onepassword") (hasKey .onepassword "account") -}}
    {{- $opAccount = .onepassword.account -}}
  {{- end -}}
  {{- if eq $opAccount "" -}}
    {{- $opAccount = promptString "1Password account shorthand (optional; enter - to skip permanently)" -}}
  {{- end -}}
  {{- /* OPTIONAL: keep the sentinel verbatim (trimmed, case-insensitive). */ -}}
  {{- $opAccount = trim $opAccount -}}
  {{- if or (eq $opAccount "-") (eq (lower $opAccount) "none") -}}{{- $opAccount = "-" -}}{{- end -}}
  {{- end -}}
{{- /* LEGACY: kept so hosts configured before the resolve-1password hook keep
     rendering. New machines leave it empty; the key now lives in a 1Password
     item and is resolved into ~/.config/git/ssh-signing-key at apply time. */ -}}
{{- $sshSigningKey := "" -}}
{{- if and (hasKey . "onepassword") (hasKey .onepassword "ssh_signing_key") -}}
  {{- $sshSigningKey = .onepassword.ssh_signing_key -}}
{{- end -}}
{{- /* LEGACY, DEPRECATED: a hand-maintained list of "NAME=value" strings.
     The supported path is `secrets` above, resolved by the resolve-1password
     hook into ~/.config/sh/secrets.env (mode 0600) and sourced by .zprofile.
     An existing non-empty list is carried forward verbatim on re-init so a
     re-render never silently drops a live entry; dot_zprofile.tmpl renders this
     list AFTER the secrets.env source line, so migrated values win. */ -}}
{{- $envvars := list -}}
{{- if and (hasKey . "envvars") .envvars -}}
  {{- $envvars = .envvars -}}
{{- end -}}
{{- $deferCLT := false -}}
{{- if and (hasKey . "bootstrap") (hasKey .bootstrap "defer_clt") -}}
  {{- $deferCLT = .bootstrap.defer_clt -}}
{{- else -}}
  {{- $deferCLT = promptBool "Defer Command Line Tools install during bootstrap" false -}}
{{- end -}}
{{- $deferXcode := false -}}
{{- if and (hasKey . "bootstrap") (hasKey .bootstrap "defer_xcode") -}}
  {{- $deferXcode = .bootstrap.defer_xcode -}}
{{- else -}}
  {{- $deferXcode = promptBool "Defer full Xcode install during bootstrap" false -}}
{{- end -}}
{{- $assumeYes := false -}}
{{- if and (hasKey . "bootstrap") (hasKey .bootstrap "assume_yes") -}}
  {{- $assumeYes = .bootstrap.assume_yes -}}
{{- else -}}
  {{- $assumeYes = promptBool "Skip installation confirmations during bootstrap (config values still prompt)" false -}}
{{- end -}}
{{- /* Emit exactly one newline before sourceDir: (see commit dddbafd9). */}}
sourceDir: ~/MeinCodex/Codebasis/github.com/neumachen/dotfiles
diff:
  command: nvim
  pager: ""
  args:
    - -d
    - "{{`{{ .Destination }}`}}"
    - "{{`{{ .Target }}`}}"
merge:
  command: nvim
  args:
    - -d
    - "{{`{{ .Destination }}`}}"
    - "{{`{{ .Source }}`}}"
    - "{{`{{ .Target }}`}}"
data:
  onepassword:
    enabled: {{ $opEnabled }}
    vault: {{ $vault | quote }}
    account: {{ $opAccount | quote }}
    ssh_key_item: {{ $sshKeyItem | quote }}
    ssh_signing_key: {{ $sshSigningKey | quote }}
    app_path: {{ $onePasswordApp | quote }}
  git:
    email: {{ $gitEmail | quote }}
    name: {{ $gitName | quote }}
    profile: |
      [user]
        email = {{ $gitEmail }}
        name = {{ $gitName }}
    # Directory-specific git profiles
    # Example:
    #   profiles:
    #     - name: work
    #       gitdir: ~/work/
    #       email: work@example.com
    #       # name: Optional (inherits from git.name if omitted)
    #       # signingKey: Optional (inherits from onepassword.ssh_signing_key if omitted)
    profiles: []
  secrets:
{{- $hasSecrets := false -}}
{{- if hasKey . "secrets" -}}
  {{- range $name, $ref := .secrets -}}
    {{- if and $ref (ne (trim $ref) "") -}}
      {{- $hasSecrets = true -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- if $hasSecrets }}
{{- range $name, $ref := .secrets }}
{{- $ref = trim $ref }}
{{- if ne $ref "" }}
    {{ $name }}: {{ $ref | quote }}
{{- end }}
{{- end }}
{{- else }}
    {}
{{- end }}
{{- if $envvars }}
  # LEGACY/DEPRECATED: carried forward verbatim from the previous config so a
  # re-init never drops a live entry. Migrate these to `secrets` above; the
  # supported runtime path is ~/.config/sh/secrets.env (see dot_zprofile.tmpl).
  envvars:
{{- range $envvars }}
{{- if regexMatch `^[A-Za-z_][A-Za-z0-9_]*=[^:#"']*$` . }}
    - {{ . }}
{{- else }}
    - {{ . | quote }}
{{- end }}
{{- end }}
{{- else }}
  envvars: []
{{- end }}
  bootstrap:
    defer_clt: {{ $deferCLT }}
    defer_xcode: {{ $deferXcode }}
    assume_yes: {{ $assumeYes }}

