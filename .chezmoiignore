# Obsidian vault content — managed at runtime, not by Chezmoi
# Note: akten/, zakki/, kadai/ dirs are created by a chezmoi run-once script.
# Note content is never tracked, but _bases/ subdirectories ARE tracked for Obsidian Bases.
# assets/ is created by Obsidian on first attachment drop; never tracked.
#
# Although chezmoi does support !-negation in .chezmoiignore, the vault-content
# layout here is cleaner expressed by explicitly ignoring the year subdirs
# (where notes live) so _bases/ passes through without an extra unignore rule.
MeinCodex/Notizen/Obsidian/Main/akten/[0-9]*
MeinCodex/Notizen/Obsidian/Main/zakki/[0-9]*
MeinCodex/Notizen/Obsidian/Main/kadai/[0-9]*
MeinCodex/Notizen/Obsidian/Main/assets/**
# Home.md is the vault landing-page note (dashboard). It is content owned by the
# vault's own git repo (like akten/zakki/kadai notes), not chezmoi-managed config.
MeinCodex/Notizen/Obsidian/Main/Home.md

# Obsidian plugin compiled/bundled files — downloaded by Obsidian on first launch, not tracked.
# manifest.json (tracked) is sufficient for Obsidian to detect and download missing plugins.
# Exception: local-only plugins (those not in the community store) must ship their own
# main.js because Obsidian has nothing to download. Chezmoi DOES support !-negation
# in .chezmoiignore (since v2.0); list each local plugin's main.js as an explicit
# allow so the directory glob keeps catching upstream community-plugin builds.
MeinCodex/Notizen/Obsidian/Main/.obsidian/plugins/**/main.js
MeinCodex/Notizen/Obsidian/Main/.obsidian/plugins/**/styles.css
!MeinCodex/Notizen/Obsidian/Main/.obsidian/plugins/mein-codex-sync/main.js

# Obsidian runtime-generated files inside .obsidian — volatile state written by Obsidian at runtime.
# These are created/updated by Obsidian itself; not configuration we author.
# workspace.json: open-pane layout, rewritten every session
# workspace-mobile.json: mobile layout state
# graph.json: graph view position/filter state
# starred.json: starred files (legacy — Obsidian v1.2+ uses bookmarks.json)
# bookmarks.json: runtime bookmark state
MeinCodex/Notizen/Obsidian/Main/.obsidian/workspace.json
MeinCodex/Notizen/Obsidian/Main/.obsidian/workspace-mobile.json
MeinCodex/Notizen/Obsidian/Main/.obsidian/graph.json
MeinCodex/Notizen/Obsidian/Main/.obsidian/starred.json
MeinCodex/Notizen/Obsidian/Main/.obsidian/bookmarks.json

# Obsidian plugin runtime/cache files — generated by plugins at runtime, not tracked.
# NOTE: data.json (plugin settings) and manifest.json are still tracked above — only volatile
# cache/index files produced at runtime need to be excluded here.
MeinCodex/Notizen/Obsidian/Main/.obsidian/plugins/omnisearch/*.db
MeinCodex/Notizen/Obsidian/Main/.obsidian/plugins/omnisearch/*-cache.*

# Bootstrap resolved state — written by .chezmoiscripts hooks at apply time.
# These are NOT authored config and are NOT tracked; chezmoi must leave them
# alone. This is load-bearing, not cosmetic: ~/.config/git is an `exact_`
# directory (source: private_dot_config/exact_git), so chezmoi deletes any file
# in it that is not in the source state — without the entry below it would wipe
# the resolved SSH signing key on every single apply.
# Patterns are target paths (relative to $HOME).
#
#   .config/git/ssh-signing-key   one line: the SSH *public* key resolved from a
#                                 1Password item by
#                                 run_onchange_after_70-resolve-1password.sh.tmpl.
#                                 Read by private_profile.tmpl,
#                                 private_allowed_signers.tmpl and
#                                 private_config.tmpl via stat + output "cat".
#   .config/sh/secrets.env        0600 `export NAME='<value>'` lines resolved from
#                                 1Password by the same hook; sourced by .zprofile
#                                 rather than rendered inline, so a locked or
#                                 absent 1Password never blocks login.
#   .cache/chezmoi/bootstrap-status.json
#   .cache/chezmoi/bootstrap-status.txt
#                                 Status document (contract C3) written by
#                                 run_after_99-bootstrap-status.sh.tmpl on every
#                                 apply, or by ~/.local/bin/bootstrap-status.
.config/git/ssh-signing-key
.config/sh/secrets.env
.cache/chezmoi/bootstrap-status.json
.cache/chezmoi/bootstrap-status.txt

