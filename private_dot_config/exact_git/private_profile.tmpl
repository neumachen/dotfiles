{{- /*
  SSH signing block, gated on RESOLVED state (~/.config/git/ssh-signing-key,
  written by run_onchange_after_70-resolve-1password) rather than on the
  1Password.app bundle. Gating on resolved state is what removes the need for a
  second `chezmoi apply` to get a correct git config: the signing block used to
  be baked into data.git.profile by .chezmoi.yaml.tmpl, which only re-renders on
  `chezmoi init`.

  The key file is read with stat + output "cat", never include: chezmoi's
  include resolves relative to the SOURCE directory, not the filesystem. output
  aborts template execution if the command fails, so it is always guarded by
  stat.

  .git.profile is a block scalar ending in a newline; trimSuffix it so the
  signing block abuts `name = ...` with no blank line, and so the no-signing
  case still ends in exactly one newline.

  Ordering constraint: signingKey must be emitted before the [gpg] header so it
  lands inside the [user] section opened by .git.profile.
*/ -}}
{{- /* D1: guard the LEGACY .git.profile as well as the new-schema keys. A
       pre-refactor ~/.config/chezmoi/chezmoi.yaml may have no git block at all,
       and chezmoi only regenerates that file on `chezmoi init`, so an unguarded
       read would abort every render with "map has no entry for key".
       D2: normalise the "-" / "none" skip sentinel to empty (case-insensitive,
       trimmed) so a deliberately-skipped value can never be emitted literally.
       These assignments are placed before the literal text on purpose: every one
       is {{- ... -}} so it emits nothing, and putting them after
       "# vim:ft=gitconfig" would let {{- eat the blank line that follows it. */ -}}
{{- $gitProfile := "" -}}
{{- if and (hasKey . "git") (hasKey .git "profile") -}}
  {{- $gitProfile = .git.profile -}}
{{- end -}}
{{- if or (eq (trim $gitProfile) "-") (eq (lower (trim $gitProfile)) "none") -}}
  {{- $gitProfile = "" -}}
{{- end -}}
{{- $opApp := "" -}}
{{- $opEnabled := false -}}
{{- if and (hasKey . "onepassword") (hasKey .onepassword "app_path") -}}
  {{- $opApp = .onepassword.app_path -}}
{{- end -}}
{{- if or (eq (trim $opApp) "-") (eq (lower (trim $opApp)) "none") -}}
  {{- $opApp = "" -}}
{{- end -}}
{{- if and (hasKey . "onepassword") (hasKey .onepassword "enabled") -}}
  {{- $opEnabled = .onepassword.enabled -}}
{{- end -}}
# vim:ft=gitconfig

{{ $gitProfile | trimSuffix "\n" -}}
{{- $keyFile := joinPath .chezmoi.homeDir ".config/git/ssh-signing-key" -}}
{{- if and $opEnabled (ne $opApp "") (stat $keyFile) }}
  signingKey = {{ output "cat" $keyFile | trim }}
[gpg]
  format = ssh
[gpg "ssh"]
  program = "{{ $opApp }}/Contents/MacOS/op-ssh-sign"
  allowedSignersFile = ~/.config/git/allowed_signers
[commit]
  gpgsign = true
{{- end }}
