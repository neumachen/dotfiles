#!/usr/bin/env bash
# chezmoi modify_ script for ~/.claude/settings.json.
#
# chezmoi pipes the CURRENT target file in on stdin and writes our stdout back
# out as the new target. So we merge the managed settings below over whatever is
# live, which preserves runtime-generated keys (notably autoMode.environment,
# which Claude Code regenerates and which must never be clobbered by an apply).
#
# Consequence to know: this only ever SETS keys. Deleting a managed key here does
# not remove it from the live file - add its path to REMOVE_PATHS instead.
set -euo pipefail

if ! command -v jq >/dev/null 2>&1; then
  echo "modify_settings.json: jq is not on PATH; refusing to rewrite settings" >&2
  exit 1
fi

# jq paths to delete from the live file, e.g. [["someObsoleteKey"]]
REMOVE_PATHS='[]'

MANAGED=$(cat <<'MANAGED_JSON'
{
  "model": "claude-opus-5[1m]",
  "effortLevel": "xhigh",
  "viewMode": "default",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "companyAnnouncements": [],
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "api.github.com",
        "github.com",
        "codeload.github.com",
        "objects.githubusercontent.com"
      ]
    }
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(echo *)",
      "Bash(npm *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(gh pr *)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:npmjs.org)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf /*)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/id_dsa*)",
      "Read(**/.ssh/**)",
      "Read(**/.gnupg/**)",
      "Read(**/*.key)",
      "Read(**/*_key)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*keyring*)",
      "Read(**/*token*)",
      "Read(**/secrets/**)",
      "Read(**/.secrets/**)",
      "Read(**/secrets.*)",
      "Read(**/*.secret)",
      "Read(**/*_secret)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_ed25519*)",
      "Edit(**/id_ecdsa*)",
      "Edit(**/id_dsa*)",
      "Edit(**/*.key)",
      "Edit(**/*_key)",
      "Edit(**/*.pem)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/*.keystore)",
      "Edit(**/*.jks)",
      "Edit(**/*keyring*)",
      "Edit(**/secrets/**)",
      "Edit(**/.secrets/**)",
      "Edit(**/secrets.*)",
      "Edit(**/*.secret)",
      "Edit(**/*_secret)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.development)",
      "Edit(.env.production)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)"
    ],
    "ask": [
      "Bash(wget *)",
      "Bash(curl *)",
      "Bash(git merge *)"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "autoUpdater": {
    "disabled": true
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "DISABLE_AUTOUPDATER": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/kareemh/.claude/hooks/git-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
MANAGED_JSON
)

current=$(cat)
printf '%s' "$current" | jq -e . >/dev/null 2>&1 || current='{}'

printf '%s' "$current" | jq \
  --argjson managed "$MANAGED" \
  --argjson remove "$REMOVE_PATHS" \
  'reduce $remove[] as $p (.; delpaths([$p])) | . * $managed'
